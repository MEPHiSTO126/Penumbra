---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, machineDateString } from '../lib/date';

export async function getStaticPaths() {
  const now = new Date();
  const essays = await getCollection(
    'essays',
    ({ data }) => !data.draft && data.pubDate.getTime() <= now.getTime(),
  );

  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const permalink = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<BaseLayout
  title={essay.data.title}
  description={essay.data.description}
  published={essay.data.pubDate}
>
  <article>
    <header class="essay-head">
      <h1 class="essay-title">{essay.data.title}</h1>
      <p class="essay-meta">
        <time datetime={machineDateString(essay.data.pubDate)}>
          {formatDate(essay.data.pubDate)}
        </time>
        {
          essay.data.updatedDate && (
            <span> · revised {formatDate(essay.data.updatedDate)}</span>
          )
        }
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="essay-foot">
      <button type="button" class="copy-link" data-url={permalink}>Copy link</button>
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    var button = document.querySelector('.copy-link');
    if (!button) return;

    var label = button.textContent;
    var timer;

    function markCopied() {
      button.textContent = 'Copied';
      button.classList.add('is-copied');
      clearTimeout(timer);
      timer = setTimeout(function () {
        button.textContent = label;
        button.classList.remove('is-copied');
      }, 2000);
    }

    function legacyCopy(url) {
      var field = document.createElement('textarea');
      field.value = url;
      field.setAttribute('readonly', '');
      field.style.position = 'absolute';
      field.style.left = '-9999px';
      document.body.appendChild(field);
      field.select();
      try {
        document.execCommand('copy');
      } catch (e) {}
      document.body.removeChild(field);
    }

    button.addEventListener('click', function () {
      var url = button.dataset.url;

      // Feedback is immediate; the write itself is effectively instant when
      // it succeeds. If it fails, the URL is still in the address bar.
      markCopied();

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).catch(function () {
          legacyCopy(url);
        });
      } else {
        legacyCopy(url);
      }
    });
  })();
</script>
